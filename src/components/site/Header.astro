---
import { LiquidGlassSurface } from "@rawr-labs/liquid-glass/astro";

const links = [
	{ href: "/", label: "Home" },
	{ href: "/components/", label: "Components" },
];
---

<header class="fixed inset-x-0 top-0 z-50 px-3 py-3">
	<div class="relative mx-auto flex h-16 w-full max-w-7xl overflow-hidden rounded-full border border-white/10">
		<LiquidGlassSurface
			id="site-navigation-glass"
			class="absolute inset-0"
			radius="capsule"
			bezel={0}
			scale={2}
			activeEdges="all"
			fillRefraction
			interiorLens="fisheye"
			deformationX={3}
			deformationY={3}
			frosted={4}
			frostedTint="white"
		/>
		<div class="relative z-10 flex h-full w-full items-center gap-8 px-5">
			<a href="/" class="focus-ring rounded-md text-base font-black tracking-wide">
				Rawr Labs
			</a>
			<nav aria-label="Primary navigation" class="flex min-w-0 items-center gap-1">
				{
					links.map((link) => (
						<a
							href={link.href}
							class="focus-ring rounded-md px-3 py-2 text-sm font-semibold text-white/74 transition hover:text-white"
						>
							{link.label}
						</a>
					))
				}
			</nav>
		</div>
	</div>
</header>
