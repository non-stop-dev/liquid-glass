---
import { Check, ChevronDown, Clipboard } from "@lucide/astro";

interface CodeExample {
	label: string;
	code: string;
}

interface Props {
	id: string;
	examples: readonly CodeExample[];
}

const { id, examples } = Astro.props;
---

<details
	class="group relative w-full min-w-0 max-w-full overflow-hidden border-t border-white/10 pt-3"
	data-code-tabs={id}
	style="contain: inline-size;"
>
	<summary
		class="focus-ring flex min-w-0 cursor-pointer list-none items-center gap-2 rounded-md py-2 pr-12 text-left text-xs font-black uppercase tracking-[0.18em] text-secondary transition hover:text-white [&::-webkit-details-marker]:hidden"
	>
			<ChevronDown
				size={16}
				stroke-width={2.4}
				aria-hidden="true"
				class="shrink-0 transition-transform group-open:rotate-180"
			/>
			<span class="min-w-0 truncate">Code examples</span>
	</summary>
	<div
		id={`${id}-content`}
		class="mt-2 w-full min-w-0 max-w-full overflow-hidden border-t border-white/10"
		data-code-content
		style="contain: inline-size;"
	>
		<div class="flex items-center gap-2 border-b border-white/10 p-2">
			<div class="flex min-w-0 flex-1 gap-1 overflow-x-auto" role="tablist" aria-label="Code examples">
				{
					examples.map((example, index) => (
						<button
							type="button"
							id={`${id}-tab-${index}`}
							class="code-tab focus-ring shrink-0 rounded-md border border-transparent px-3 py-2 text-xs font-bold text-white/68 transition"
							role="tab"
							aria-selected={index === 0 ? "true" : "false"}
							aria-controls={`${id}-panel-${index}`}
							data-tab-index={index}
						>
							{example.label}
						</button>
					))
				}
			</div>
			<button
				type="button"
				class="focus-ring relative grid size-10 shrink-0 place-items-center rounded-md text-white/68 transition hover:text-primary data-[copy-state=copied]:text-primary data-[copy-state=error]:text-secondary"
				aria-label="Copy active code example"
				title="Copy code"
				data-copy-state="idle"
				data-copy-code
			>
				<span class="copy-icon copy-icon-clipboard" aria-hidden="true">
					<Clipboard size={17} stroke-width={2.3} />
				</span>
				<span class="copy-icon copy-icon-check" aria-hidden="true">
					<Check size={18} stroke-width={2.7} />
				</span>
			</button>
		</div>
		{
			examples.map((example, index) => (
				<pre
				id={`${id}-panel-${index}`}
					class="code-panel code-snippet m-0 h-[min(32rem,calc(100vh-14rem))] min-h-72 w-full min-w-0 max-w-full overflow-auto overscroll-contain p-4 text-sm leading-6 text-white/88"
					role="tabpanel"
					aria-labelledby={`${id}-tab-${index}`}
					aria-label={`${example.label} code example`}
					hidden={index !== 0}
					tabindex="0"
				><code>{example.code}</code></pre>
			))
		}
	</div>
</details>

<script>
	const tabWindow = window as Window & {
		rawrCodeTabsReadyV6?: boolean;
	};

	if (!tabWindow.rawrCodeTabsReadyV6) {
		tabWindow.rawrCodeTabsReadyV6 = true;

		const setCopyState = (
			button: HTMLButtonElement,
			state: "idle" | "copied" | "error",
		) => {
			button.dataset.copyState = state;
			button.setAttribute(
				"aria-label",
				state === "copied"
					? "Code copied"
					: state === "error"
						? "Copy failed"
						: "Copy active code example",
			);

			if (state === "idle") {
				return;
			}

			window.setTimeout(() => {
				button.dataset.copyState = "idle";
				button.setAttribute("aria-label", "Copy active code example");
			}, 3000);
		};

		const copyWithTextarea = (text: string) => {
			const textarea = document.createElement("textarea");
			textarea.value = text;
			textarea.setAttribute("readonly", "true");
			textarea.style.position = "fixed";
			textarea.style.top = "0";
			textarea.style.left = "0";
			textarea.style.opacity = "0";
			document.body.append(textarea);
			textarea.select();
			const didCopy = document.execCommand("copy");
			textarea.remove();

			if (!didCopy) {
				throw new Error("Clipboard copy failed.");
			}
		};

		const copyText = async (text: string) => {
			try {
				copyWithTextarea(text);
				return;
			} catch {
				if (!navigator.clipboard) {
					throw new Error("Clipboard copy failed.");
				}
			}

			await navigator.clipboard.writeText(text);
		};

		document.addEventListener("click", (event) => {
			const target = event.target;

			if (!(target instanceof Element)) {
				return;
			}

			const copyButton = target.closest<HTMLButtonElement>("[data-copy-code]");

			if (copyButton) {
				const root = copyButton.closest<HTMLElement>("[data-code-tabs]");
				const panel = root?.querySelector<HTMLElement>("[role='tabpanel']:not([hidden])");
				const code = panel?.textContent;

				if (!code) {
					setCopyState(copyButton, "error");
					return;
				}

				void copyText(code)
					.then(() => setCopyState(copyButton, "copied"))
					.catch(() => setCopyState(copyButton, "error"));
				return;
			}

			const selectedTab = target.closest<HTMLButtonElement>(
				"[data-code-tabs] [role='tab'][data-tab-index]",
			);

			if (!selectedTab) {
				return;
			}

			const root = selectedTab.closest<HTMLElement>("[data-code-tabs]");

			if (!root) {
				return;
			}

			const selectedIndex = Number(selectedTab.dataset.tabIndex);
			const tabs = Array.from(
				root.querySelectorAll<HTMLButtonElement>("[role='tab']"),
			);
			const panels = Array.from(
				root.querySelectorAll<HTMLElement>("[role='tabpanel']"),
			);

			tabs.forEach((candidate, index) => {
				candidate.setAttribute("aria-selected", String(index === selectedIndex));
			});

			panels.forEach((panel, index) => {
				panel.hidden = index !== selectedIndex;
			});
		}, { capture: true });
	}
</script>
