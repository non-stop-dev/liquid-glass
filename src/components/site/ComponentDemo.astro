---
import { ChevronLeft, ChevronRight } from "@lucide/astro";
import { LiquidGlassSurface } from "@rawr-labs/liquid-glass/astro";
import CodeTabs from "./CodeTabs.astro";

interface Props {
	id: string;
	title: string;
	variant?: "nav" | "card" | "button";
}

const { id, title, variant = "nav" } = Astro.props;
const isButton = variant === "button";
const shape = "rounded-rect";
const hostClass = isButton
	? "relative grid size-24 place-items-center"
	: variant === "card"
		? "relative min-h-64"
		: "relative h-18";
const radius = variant === "card" ? 1.2 : 10;
const bezel = 0.5;
const scale = 1;
const frosted = 4;
const deformationY = variant === "nav" ? 3 : 2;
const backgroundImages = [
	"/backgrounds-for-components/pexels-alexant-7004739.jpg",
	"/backgrounds-for-components/pexels-karola-g-4022107.jpg",
	"/backgrounds-for-components/pexels-lilartsy-3750777.jpg",
	"/backgrounds-for-components/pexels-maria-doina-mareggini-898057922-37252471.jpg",
] as const;
const firstBackground = backgroundImages[0];
const contentMarkup = isButton
	? `<span>${title}</span>`
	: `<strong>${title}</strong>
  <span class="hidden text-sm font-semibold text-white/76 lg:inline">One filtered layer</span>`;
const contentClass = isButton
	? "relative z-10 text-sm font-black"
	: variant === "card"
		? "relative z-10 flex min-h-64 items-start justify-between p-12 text-white"
		: "relative z-10 flex h-full items-center justify-between px-5 text-white";
const canvasClass =
	"relative h-[clamp(22rem,52vw,34rem)] w-full overflow-hidden rounded-lg bg-ink";
const backgroundImageClass =
	"absolute left-0 top-1/2 h-auto w-full max-w-none -translate-y-1/2 transition-opacity duration-300";
const draggableClass =
	variant === "card"
		? "absolute left-1/2 top-14 z-10 w-[min(28rem,calc(100%-2.5rem))] -translate-x-1/2 cursor-grab touch-none select-none active:cursor-grabbing"
		: variant === "button"
			? "absolute left-8 top-18 z-10 cursor-grab touch-none select-none active:cursor-grabbing"
			: "absolute left-5 top-18 z-10 w-[min(46rem,calc(100%-2.5rem))] cursor-grab touch-none select-none active:cursor-grabbing";
const staticExampleClass =
	variant === "card"
		? "absolute left-1/2 top-14 z-10 w-[min(28rem,calc(100%-2.5rem))] -translate-x-1/2"
		: variant === "button"
			? "absolute left-8 top-18 z-10"
			: "absolute left-5 top-18 z-10 w-[min(46rem,calc(100%-2.5rem))]";
const cssSurfaceRules =
	variant === "card"
		? `  position: absolute;
  left: 50%;
  top: 3.5rem;
  z-index: 10;
  width: min(28rem, calc(100% - 2.5rem));
  transform: translateX(-50%);`
		: variant === "button"
			? `  position: absolute;
  left: 2rem;
  top: 4.5rem;
  z-index: 10;`
			: `  position: absolute;
  left: 1.25rem;
  top: 4.5rem;
  z-index: 10;
  width: min(46rem, calc(100% - 2.5rem));`;
const propRows = [
	["id", `"${id}"`],
	["shape", `"${shape}"`],
	["radius", typeof radius === "number" ? String(radius) : `"${radius}"`],
	["bezel", String(bezel)],
	["scale", String(scale)],
	["activeEdges", `"all"`],
	["fillRefraction", "true"],
	["interiorLens", `"fisheye"`],
	["deformationX", "3"],
	["deformationY", String(deformationY)],
	["frosted", String(frosted)],
	["frostedTint", `"white"`],
] as const;
const htmlAttributes = `id="${id}"
    class="absolute inset-0"
    shape="${shape}"
    radius="${radius}"
    bezel="${bezel}"
    scale="${scale}"
    active-edges="all"
    fill-refraction="true"
    interior-lens="fisheye"
    deformation-x="3"
    deformation-y="${deformationY}"
    frosted="${frosted}"
    frosted-tint="white"`;
const astroProps = `id="${id}"
    class="absolute inset-0"
    shape="${shape}"
    radius={${typeof radius === "number" ? radius : `"${radius}"`}}
    bezel={${bezel}}
    scale={${scale}}
    activeEdges="all"
    fillRefraction
    interiorLens="fisheye"
    deformationX={3}
    deformationY={${deformationY}}
    frosted={${frosted}}
    frostedTint="white"`;
const reactProps = `id="${id}"
        className="absolute inset-0"
        shape="${shape}"
        radius={${typeof radius === "number" ? radius : `"${radius}"`}}
        bezel={${bezel}}
        scale={${scale}}
        activeEdges="all"
        fillRefraction
        interiorLens="fisheye"
        deformationX={3}
        deformationY={${deformationY}}
        frosted={${frosted}}
        frostedTint="white"`;
const codeExamples = [
	{
		label: "HTML",
		code: `<script type="module">
  import "@rawr-labs/liquid-glass";
  import "@rawr-labs/liquid-glass/styles.css";
</script>

<section class="demo-frame">
  <img class="demo-bg" src="${firstBackground}" alt="" />
  <div class="demo-surface">
    <div class="${hostClass}">
      <liquid-glass-surface
      ${htmlAttributes}
      ></liquid-glass-surface>
      <div class="${contentClass}">
        ${contentMarkup}
      </div>
    </div>
  </div>
</section>`,
	},
	{
		label: "CSS",
		code: `.demo-frame {
  position: relative;
  width: 100%;
  height: clamp(22rem, 52vw, 34rem);
  overflow: hidden;
  border-radius: 0.5rem;
}

.demo-bg {
  position: absolute;
  left: 0;
  top: 50%;
  width: 100%;
  height: auto;
  max-width: none;
  transform: translateY(-50%);
}

.glass-content {
  position: relative;
  z-index: 10;
}

.demo-surface {
${cssSurfaceRules}
}`,
	},
	{
		label: "Tailwind",
		code: `<section class="${canvasClass}">
  <img class="${backgroundImageClass}" src="${firstBackground}" alt="" />
  <div class="${staticExampleClass}">
    <div class="${hostClass}">
      <liquid-glass-surface
      ${htmlAttributes}
      ></liquid-glass-surface>
      <div class="${contentClass}">
        ${contentMarkup}
      </div>
    </div>
  </div>
</section>`,
	},
	{
		label: "TypeScript",
		code: `import type { LiquidGlassProps } from "@rawr-labs/liquid-glass";

export const ${id.replaceAll("-", "")}Props: LiquidGlassProps = {
  ${propRows.map(([name, value]) => `${name}: ${value}`).join(",\n  ")},
};`,
	},
	{
		label: "Astro",
		code: `---
import { LiquidGlassSurface } from "@rawr-labs/liquid-glass/astro";
---

<section class="${canvasClass}">
  <img class="${backgroundImageClass}" src="${firstBackground}" alt="" />
  <div class="${staticExampleClass}">
    <div class="${hostClass}">
      <LiquidGlassSurface
      ${astroProps}
      />
      <div class="${contentClass}">
        ${contentMarkup}
      </div>
    </div>
  </div>
</section>`,
	},
	{
		label: "React",
		code: `import { LiquidGlassSurface } from "@rawr-labs/liquid-glass/react";

export function ${variant === "nav" ? "NavigationSurface" : variant === "card" ? "CardSurface" : "ActionSurface"}() {
  return (
    <section className="${canvasClass}">
      <img className="${backgroundImageClass}" src="${firstBackground}" alt="" />
      <div className="${staticExampleClass}">
        <div className="${hostClass}">
          <LiquidGlassSurface
          ${reactProps}
          />
          <div className="${contentClass}">
            ${contentMarkup}
          </div>
        </div>
      </div>
    </section>
  );
}`,
	},
];
---

<section
	class="w-full min-w-0 overflow-hidden rounded-lg border border-white/10 bg-white/[0.03] p-4"
	data-component-demo={id}
	data-glass-radius={radius}
	data-glass-bezel={bezel}
	data-glass-frosted={frosted}
	data-glass-scale={scale}
	data-glass-tint="white"
	data-glass-lens="fisheye"
	style="contain: inline-size;"
>
	<div
		class={canvasClass}
		data-background-carousel
		data-demo-canvas
	>
		<div class="absolute inset-0" aria-hidden="true">
			{
				backgroundImages.map((image, index) => (
					<img
						src={image}
						alt=""
						loading={index === 0 ? "eager" : "lazy"}
						class:list={[
							backgroundImageClass,
							index === 0 ? "opacity-100" : "opacity-0",
						]}
						data-background-image
					/>
				))
			}
			<div class="absolute inset-0 bg-black/28"></div>
			<div class="absolute inset-0 bg-gradient-to-br from-primary/18 via-ink/14 to-secondary/18"></div>
		</div>
		<div class="absolute left-4 top-4 z-30 flex gap-2">
			<div class="relative grid size-10 shrink-0">
				<LiquidGlassSurface
					id={`${id}-previous-action`}
					class="absolute inset-0"
					shape="circle"
					radius={10}
					bezel={0.5}
					scale={3}
					activeEdges="all"
					fillRefraction
					interiorLens="fisheye"
					deformationX={2}
					deformationY={2}
					frosted={3}
					frostedTint="white"
				/>
				<button
					type="button"
					class="liquid-action-button focus-ring relative z-10 grid size-10 place-items-center rounded-full border border-white/16 text-white transition-transform duration-200 ease-out hover:scale-105 active:scale-95"
					aria-label={`Previous background for ${title}`}
					data-background-previous
				>
					<ChevronLeft size={20} stroke-width={2.4} aria-hidden="true" />
				</button>
			</div>
			<div class="relative grid size-10 shrink-0">
				<LiquidGlassSurface
					id={`${id}-next-action`}
					class="absolute inset-0"
					shape="circle"
					radius={10}
					bezel={0.5}
					scale={3}
					activeEdges="all"
					fillRefraction
					interiorLens="fisheye"
					deformationX={2}
					deformationY={2}
					frosted={3}
					frostedTint="white"
				/>
				<button
					type="button"
					class="liquid-action-button focus-ring relative z-10 grid size-10 place-items-center rounded-full border border-white/16 text-white transition-transform duration-200 ease-out hover:scale-105 active:scale-95"
					aria-label={`Next background for ${title}`}
					data-background-next
				>
					<ChevronRight size={20} stroke-width={2.4} aria-hidden="true" />
				</button>
			</div>
		</div>
		<p class="absolute bottom-4 left-4 z-20 rounded-md bg-black/45 px-3 py-2 text-xs font-bold text-white/72 backdrop-blur-md">
			Drag the glass surface across the background
		</p>
		<div
			class={draggableClass}
			data-draggable-glass
			aria-label={`Drag ${title}`}
		>
			<div class={hostClass}>
				<LiquidGlassSurface
					id={id}
					class="absolute inset-0"
					shape={shape}
					radius={radius}
					bezel={bezel}
					scale={scale}
					activeEdges="all"
					fillRefraction
					interiorLens="fisheye"
					deformationX={3}
					deformationY={deformationY}
					frosted={frosted}
					frostedTint="white"
				/>
				<div class={contentClass}>
					{
						isButton ? (
							<span>{title}</span>
						) : (
								<>
									<strong>{title}</strong>
									<span class="hidden text-sm font-semibold text-white/76 lg:inline">One filtered layer</span>
								</>
						)
					}
				</div>
			</div>
			</div>
		</div>
		<div
			class="glass-demo-controls-panel mt-3"
			aria-label={`${title} liquid glass controls`}
		>
			<div class="grid min-w-0 gap-3 sm:grid-cols-2 xl:grid-cols-4">
				<label class="glass-demo-range">
					<span class="glass-demo-range-label">
						<span>Radius</span>
						<output data-glass-output="radius">{radius}</output>
					</span>
					<input
						type="range"
						min="0"
						max="10"
						step="0.1"
						value={radius}
						style={`--glass-range-value: ${radius * 10}%`}
						aria-label="Radius"
						data-glass-range="radius"
						data-glass-attribute="radius"
					/>
				</label>
				<label class="glass-demo-range">
					<span class="glass-demo-range-label">
						<span>Bezel</span>
						<output data-glass-output="bezel">{bezel}</output>
					</span>
					<input
						type="range"
						min="0"
						max="10"
						step="0.1"
						value={bezel}
						style={`--glass-range-value: ${bezel * 10}%`}
						aria-label="Bezel"
						data-glass-range="bezel"
						data-glass-attribute="bezel"
					/>
				</label>
				<label class="glass-demo-range">
					<span class="glass-demo-range-label">
						<span>Frosted</span>
						<output data-glass-output="frosted">{frosted}</output>
					</span>
					<input
						type="range"
						min="0"
						max="10"
						step="0.1"
						value={frosted}
						style={`--glass-range-value: ${frosted * 10}%`}
						aria-label="Frosted"
						data-glass-range="frosted"
						data-glass-attribute="frosted"
					/>
				</label>
				<label class="glass-demo-range">
					<span class="glass-demo-range-label">
						<span>Scale</span>
						<output data-glass-output="scale">{scale}</output>
					</span>
					<input
						type="range"
						min="0"
						max="10"
						step="0.1"
						value={scale}
						style={`--glass-range-value: ${scale * 10}%`}
						aria-label="Scale"
						data-glass-range="scale"
						data-glass-attribute="scale"
					/>
				</label>
			</div>
			<div class="glass-demo-switches">
				<div class="glass-demo-switch">
					<span class="glass-demo-switch-label">Tint</span>
					<div class="glass-demo-segment" role="group" aria-label="Frosted tint">
						<button
							type="button"
							class="glass-demo-control focus-ring"
							aria-pressed="true"
							data-glass-control="tint"
							data-glass-attribute="frosted-tint"
							data-glass-value="white"
						>
							White
						</button>
						<button
							type="button"
							class="glass-demo-control focus-ring"
							aria-pressed="false"
							data-glass-control="tint"
							data-glass-attribute="frosted-tint"
							data-glass-value="black"
						>
							Black
						</button>
					</div>
				</div>
				<div class="glass-demo-switch">
					<span class="glass-demo-switch-label">Interior Lens</span>
					<div class="glass-demo-segment" role="group" aria-label="Interior lens">
						<button
							type="button"
							class="glass-demo-control focus-ring"
							aria-pressed="false"
							data-glass-control="lens"
							data-glass-attribute="interior-lens"
							data-glass-value="linear"
						>
							Linear
						</button>
						<button
							type="button"
							class="glass-demo-control focus-ring"
							aria-pressed="true"
							data-glass-control="lens"
							data-glass-attribute="interior-lens"
							data-glass-value="fisheye"
						>
							Fisheye
						</button>
					</div>
				</div>
			</div>
		</div>
		<div class="mt-4 min-w-0" style="contain: inline-size;">
			<CodeTabs id={`${id}-code`} examples={codeExamples} />
		</div>
</section>

<script>
	import { updateGlassCode } from "./demo-code.js";

	const carouselWindow = window as Window & {
		rawrBackgroundCarouselReadyV3?: boolean;
	};

	if (!carouselWindow.rawrBackgroundCarouselReadyV3) {
		carouselWindow.rawrBackgroundCarouselReadyV3 = true;

		document.addEventListener("click", (event) => {
			const target = event.target;

			if (!(target instanceof Element)) {
				return;
			}

			const previous = target.closest("[data-background-previous]");
			const next = target.closest("[data-background-next]");

			if (!previous && !next) {
				return;
			}

			const carousel = target.closest<HTMLElement>("[data-background-carousel]");

			if (!carousel) {
				return;
			}

			const images = Array.from(
				carousel.querySelectorAll<HTMLImageElement>("[data-background-image]"),
			);

			if (images.length === 0) {
				return;
			}

			const actionButton = target.closest<HTMLButtonElement>(
				"[data-background-previous], [data-background-next]",
			);

			if (
				actionButton &&
				!window.matchMedia("(prefers-reduced-motion: reduce)").matches
			) {
				actionButton.classList.remove("liquid-action-bounce");
				void actionButton.offsetWidth;
				actionButton.classList.add("liquid-action-bounce");
				actionButton.addEventListener(
					"animationend",
					() => actionButton.classList.remove("liquid-action-bounce"),
					{ once: true },
				);
			}

			const direction = previous ? -1 : 1;
			const currentIndex = Number(carousel.dataset.backgroundIndex ?? "0");
			const nextIndex = (currentIndex + direction + images.length) % images.length;

			carousel.dataset.backgroundIndex = String(nextIndex);
			images.forEach((image, imageIndex) => {
				image.classList.toggle("opacity-100", imageIndex === nextIndex);
				image.classList.toggle("opacity-0", imageIndex !== nextIndex);
			});
		});
	}

	const dragWindow = window as Window & {
		rawrGlassDragReadyV2?: boolean;
		rawrGlassControlsReadyV3?: boolean;
	};

	if (!dragWindow.rawrGlassControlsReadyV3) {
		dragWindow.rawrGlassControlsReadyV3 = true;

		const normalizeControl = (value: string) => {
			const numericValue = Number(value);
			const clampedValue = Math.max(0, Math.min(10, numericValue));
			return String(Math.round(clampedValue * 10) / 10);
		};

		const getDemoSurface = (demo: HTMLElement | null) => {
			const surfaceId = demo?.dataset.componentDemo;

			return surfaceId
				? demo?.querySelector<HTMLElement>(
						`liquid-glass-surface#${CSS.escape(surfaceId)}`,
					)
				: null;
		};

		const syncCodeExamples = (demo: HTMLElement) => {
			const radius = demo.dataset.glassRadius ?? "10";
			const bezel = demo.dataset.glassBezel ?? "0.5";
			const frosted = demo.dataset.glassFrosted ?? "4";
			const scale = demo.dataset.glassScale ?? "1";
			const tint = demo.dataset.glassTint ?? "white";
			const lens = demo.dataset.glassLens ?? "fisheye";

			demo.querySelectorAll<HTMLElement>("[role='tabpanel'] code").forEach((code) => {
				const current = code.textContent ?? "";
				const updated = updateGlassCode(current, { radius, bezel, frosted, scale, tint, lens });

				if (updated !== current) {
					code.textContent = updated;
				}
			});
		};

		const updateRangeControl = (range: HTMLInputElement) => {
			const demo = range.closest<HTMLElement>("[data-component-demo]");
			const surface = getDemoSurface(demo);
			const key = range.dataset.glassRange;
			const attribute = range.dataset.glassAttribute;
			const value = normalizeControl(range.value);

			if (!demo || !surface || !key || !attribute) {
				return;
			}

			range.value = value;
			range.style.setProperty("--glass-range-value", `${Number(value) * 10}%`);
			demo.dataset[`glass${key[0]?.toUpperCase() ?? ""}${key.slice(1)}`] = value;
			demo.querySelector<HTMLOutputElement>(`[data-glass-output="${key}"]`)?.replaceChildren(value);
			surface.setAttribute(attribute, value);
			syncCodeExamples(demo);
		};

		document.addEventListener("click", (event) => {
			const target = event.target;

			if (!(target instanceof Element)) {
				return;
			}

			const control = target.closest<HTMLButtonElement>("[data-glass-control]");

			if (!control) {
				return;
			}

			const demo = control.closest<HTMLElement>("[data-component-demo]");
			const surface = getDemoSurface(demo);
			const group = control.dataset.glassControl;
			const value = control.dataset.glassValue;

			if (!demo || !surface || !group || !value) {
				return;
			}

			if (group === "tint") {
				demo.dataset.glassTint = value;
			}

			if (group === "lens") {
				demo.dataset.glassLens = value;
			}

			surface.setAttribute("frosted-tint", demo.dataset.glassTint ?? "white");
			surface.setAttribute("interior-lens", demo.dataset.glassLens ?? "fisheye");
			syncCodeExamples(demo);

			demo
				.querySelectorAll<HTMLButtonElement>(`[data-glass-control="${group}"]`)
				.forEach((button) => {
					button.setAttribute("aria-pressed", String(button === control));
				});
		});

		document.addEventListener("input", (event) => {
			const target = event.target;

			if (!(target instanceof HTMLInputElement) || !target.matches("[data-glass-range]")) {
				return;
			}

			updateRangeControl(target);
		});
	}

	if (!dragWindow.rawrGlassDragReadyV2) {
		dragWindow.rawrGlassDragReadyV2 = true;

		let dragState:
			| {
					element: HTMLElement;
					canvas: HTMLElement;
					startClientX: number;
					startClientY: number;
					initialLeft: number;
					initialTop: number;
					width: number;
					height: number;
					positioned: boolean;
			  }
			| null = null;

		const clamp = (value: number, min: number, max: number) =>
			Math.max(min, Math.min(value, max));

		document.addEventListener("pointerdown", (event) => {
			const target = event.target;

			if (!(target instanceof Element)) {
				return;
			}

			const draggable = target.closest<HTMLElement>("[data-draggable-glass]");

			if (!draggable) {
				return;
			}

			const canvas = draggable.closest<HTMLElement>("[data-demo-canvas]");

			if (!canvas) {
				return;
			}

			const draggableRect = draggable.getBoundingClientRect();
			const canvasRect = canvas.getBoundingClientRect();

			dragState = {
				element: draggable,
				canvas,
				startClientX: event.clientX,
				startClientY: event.clientY,
				initialLeft: draggableRect.left - canvasRect.left,
				initialTop: draggableRect.top - canvasRect.top,
				width: draggableRect.width,
				height: draggableRect.height,
				positioned: false,
			};

			// Keep the original percentage/transform positioning on click. Converting
			// it to pixel coordinates here causes a visible jump before any drag.
			draggable.setPointerCapture(event.pointerId);
		});

		document.addEventListener("pointermove", (event) => {
			if (!dragState) {
				return;
			}

			const canvasRect = dragState.canvas.getBoundingClientRect();

			if (!dragState.positioned) {
				// Switch to pixel coordinates only on the first real movement. Capture
				// the visual position before clearing the centered transform so the
				// first movement is exactly the pointer delta, including a 1px drag.
				dragState.element.style.width = `${dragState.width}px`;
				dragState.element.style.height = `${dragState.height}px`;
				dragState.element.style.right = "auto";
				dragState.element.style.transform = "none";
				// Tailwind's translate utility uses the CSS `translate` longhand in
				// addition to `transform`; clear both before switching to pixel left/top.
				dragState.element.style.setProperty("translate", "none");
				dragState.element.style.left = `${dragState.initialLeft}px`;
				dragState.element.style.top = `${dragState.initialTop}px`;
				dragState.positioned = true;
			}

			const left = clamp(
				dragState.initialLeft + event.clientX - dragState.startClientX,
				0,
				Math.max(0, canvasRect.width - dragState.width),
			);
			const top = clamp(
				dragState.initialTop + event.clientY - dragState.startClientY,
				0,
				Math.max(0, canvasRect.height - dragState.height),
			);

			dragState.element.style.left = `${left}px`;
			dragState.element.style.top = `${top}px`;
		});

		document.addEventListener("pointerup", () => {
			dragState = null;
		});

		document.addEventListener("pointercancel", () => {
			dragState = null;
		});
	}
</script>
