{
	"name": "@rawr-labs/liquid-glass",
	"version": "0.1.0",
	"description": "Framework-agnostic Rawr Labs visual components with thin Astro and React wrappers.",
	"license": "MIT",
	"type": "module",
	"private": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rawr-labs/liquid-glass.git"
	},
	"bugs": {
		"url": "https://github.com/rawr-labs/liquid-glass/issues"
	},
	"homepage": "https://github.com/rawr-labs/liquid-glass#readme",
	"sideEffects": [
		"**/*.css",
		"dist/components/liquid-glass/index.js",
		"dist/components/liquid-glass/core/define-element.js",
		"dist/components/liquid-glass/react/*.js",
		"dist/components/liquid-glass/astro/*.astro"
	],
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./liquid-glass": {
			"types": "./dist/components/liquid-glass/index.d.ts",
			"default": "./dist/components/liquid-glass/index.js"
		},
		"./astro": {
			"types": "./dist/components/liquid-glass/astro/index.d.ts",
			"default": "./dist/components/liquid-glass/astro/index.js"
		},
		"./react": {
			"types": "./dist/components/liquid-glass/react/index.d.ts",
			"default": "./dist/components/liquid-glass/react/index.js"
		},
		"./styles.css": "./dist/components/liquid-glass/core/liquid-glass.css"
	},
	"scripts": {
		"dev": "astro dev --host 127.0.0.1",
		"build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
		"site:build": "astro build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"astro": ">=5 <7",
		"react": ">=18 <20"
	},
	"peerDependenciesMeta": {
		"astro": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@astrojs/react": "6.0.5",
		"@lucide/astro": "^1.14.0",
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "24.9.1",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"@vitejs/plugin-react": "^5.0.0",
		"astro": "7.3.1",
		"jsdom": "^27.0.0",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"tailwindcss": "^4.2.4",
		"typescript": "^5.9.3",
		"vite": "^7.1.0",
		"vitest": "^4.0.0"
	}
}