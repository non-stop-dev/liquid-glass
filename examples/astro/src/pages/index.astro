---
import { LiquidGlassSurface } from "@rawr-labs/visual-components/astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Liquid Glass Astro Example</title>
	</head>
	<body>
		<main class="demo">
			<div class="background-copy" aria-hidden="true">
				<span>RAWR LABS</span>
				<span>VISUAL COMPONENTS</span>
				<span>LIQUID GLASS</span>
			</div>

			<header class="glass-host">
				<LiquidGlassSurface
					id="astro-nav-glass"
					class="glass-layer"
					radius="capsule"
					bezel={1}
					scale={4.3}
					activeEdges="all"
					specularHighlight="none"
					fillRefraction
					interiorLens="fisheye"
					deformationX={3}
					deformationY={3}
					frosted={4}
					frostedTint="black"
				/>
				<nav class="content-layer" aria-label="Example navigation">
					<a href="/">Rawr Labs</a>
					<a href="#components">Components</a>
					<a href="#glass">Glass</a>
				</nav>
			</header>
		</main>
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
		background: #101114;
		color: white;
	}

	.demo {
		position: relative;
		min-height: 100vh;
		overflow: hidden;
		background:
			radial-gradient(circle at 18% 12%, rgb(42 214 191 / 78%), transparent 24rem),
			radial-gradient(circle at 80% 24%, rgb(255 210 64 / 84%), transparent 22rem),
			linear-gradient(145deg, #101114, #20232b 48%, #15171c);
	}

	.background-copy {
		position: absolute;
		inset: 0;
		display: grid;
		align-content: center;
		gap: 1rem;
		padding: 10vw;
		font-size: clamp(3rem, 13vw, 12rem);
		font-weight: 800;
		line-height: 0.88;
		letter-spacing: 0;
		color: rgb(255 255 255 / 84%);
	}

	.background-copy span:nth-child(2) {
		color: rgb(255 218 92 / 88%);
	}

	.background-copy span:nth-child(3) {
		color: rgb(63 231 203 / 82%);
	}

	.glass-host {
		position: fixed;
		top: 1.25rem;
		left: max(1rem, calc((100vw - 72rem) / 2));
		right: max(1rem, calc((100vw - 72rem) / 2));
		height: 4.5rem;
		isolation: isolate;
	}

	.glass-layer {
		position: absolute;
		inset: 0;
	}

	.content-layer {
		position: relative;
		z-index: 1;
		display: flex;
		height: 100%;
		align-items: center;
		justify-content: space-between;
		padding: 0 1.25rem;
	}

	a {
		border-radius: 0.5rem;
		color: white;
		font-weight: 700;
		text-decoration: none;
	}

	a:focus-visible {
		outline: 3px solid rgb(255 255 255 / 42%);
		outline-offset: 3px;
	}

	@media (max-width: 640px) {
		.content-layer a:nth-child(2) {
			display: none;
		}
	}
</style>
